APP_NAME="Sprintfwd Teams API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# sqlite is the zero-setup default; switch to mysql for a shared environment.
# Leave DB_DATABASE unset for sqlite: the config falls back to the absolute
# database_path("database.sqlite"). A relative path here breaks under
# `php artisan serve`, whose worker runs from a different working directory.
DB_CONNECTION=sqlite
# DB_DATABASE=
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sprintfwd
# DB_USERNAME=sprintfwd
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
